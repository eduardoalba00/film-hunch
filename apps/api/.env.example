# Copy to apps/api/.env and fill in the empty values under Required.

# ---------- Required ----------

# Postgres 17+ with pgvector. `npm run db` starts one in Docker at this address.
DATABASE_URL=postgresql://movies:movies@localhost:5433/movies

# Your own email. Wikipedia and Wikidata require a contact address from bulk clients; the seed and
# the daily sync refuse to start without it. Only sent to Wikipedia, Wikidata and TMDB.
CONTACT_EMAIL=

# TMDB API Read Access Token (the long "v4" token, not the short API key). Free:
# https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# OpenAI key, for embeddings (text-embedding-3-small): ~$0.35 for `npm run seed`, ~$1.60 for
# `npm run seed:full`, fractions of a cent per day for the sync and per search.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# TypeSafe key for Jev, the model that ranks films. Only searches use it, at about $0.045 each.
# Not needed to seed or sync.
TYPESAFE_API_KEY=

# ---------- Optional ----------

# Hard cap on Jev spend per day, in USD. Once reached, new searches pause until tomorrow; cached
# searches still work.
# DAILY_BUDGET_USD=5

# How long finished searches are cached, in hours.
# CACHE_HOURS=72

# API port (the web app's dev server forwards /api here; set API_PORT for Vite if you change it).
# PORT=3000

# Comma-separated origins allowed to call the API, when the web app is served from elsewhere.
# http://localhost:5173 is always allowed.
# WEB_ORIGIN=https://movies.example.com

# Upstash Redis, to share rate limits across several API instances. Without it, limits are kept in
# memory, which is fine for a single instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_PREFIX=fh

# Limits per visitor IP (fresh = not answered from the cache) and for the whole site:
# LIMIT_FRESH_10M=12             # fresh searches per 10 minutes
# LIMIT_FRESH_DAY=60             # fresh searches per day
# LIMIT_SEARCH_MIN=60            # any search, per minute
# LIMIT_LIGHT_MIN=240            # other endpoints, per minute
# MAX_CONCURRENT_SEARCHES=12     # searches running at once, sitewide
# OUTAGE_PAUSE_MINUTES=15        # pause after Jev or OpenAI reports no credit or a bad key

# Tuning (defaults are fine):
# DB_POOL=10                     # Postgres connections per process
# OPENAI_EMBED_TPM=900000        # embedding tokens per minute; lower it if your OpenAI tier is lower
# WARM_AFTER_IDLE_MINUTES=4      # wake the database when a page opens after this long idle
# SEARCH_COST_ESTIMATE_USD=0.05  # budget held per running search
# HOSTING_USD_PER_MONTH=0        # added to the running-cost badge in the footer
