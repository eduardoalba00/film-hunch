{
  "name": "filmhunch-api",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node scripts/migrate.mjs && node ${ENTRY:-server/index.js}",
    "dev": "node --env-file=.env --watch-path=server --watch-path=lib server/index.js",
    "sync": "node --env-file=.env scripts/sync.mjs",
    "backfill": "node --env-file=.env scripts/backfill.mjs",
    "seed": "node --env-file=.env scripts/migrate.mjs && node --env-file=.env scripts/backfill.mjs all --min-votes=100",
    "seed:full": "node --env-file=.env scripts/migrate.mjs && node --env-file=.env scripts/backfill.mjs all",
    "search": "node --env-file=.env search.mjs",
    "eval": "node --env-file=.env eval/run.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  },
  "engines": {
    "node": "24.x"
  }
}
